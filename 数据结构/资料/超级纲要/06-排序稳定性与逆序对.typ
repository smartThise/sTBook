    [1], [4与3，交换], [\[1,3,4,2\]], [尚未结束],
    [1], [4与2，交换], [\[1,3,2,4\]], [最大4已到末尾],
    [2], [1与3，不换], [\[1,3,2,4\]], [末尾4不再参与],
    [2], [3与2，交换], [\[1,2,3,4\]], [后两项3、4就位],
    [3], [1与2，不换], [\[1,2,3,4\]], [无交换，可停止],
  )]
  , kind: table
