  align(center)[#table(
    columns: 3,
    align: (auto,auto,auto,),
    table.header([合法括号串], [从左到右执行的动作], [实际输出],),
    table.hline(),
    [\((()))], [压1，压2，压3，弹3，弹2，弹1], [321],
    [\(()())], [压1，压2，弹2，压3，弹3，弹1], [231],
    [\(())()], [压1，压2，弹2，弹1，压3，弹3], [213],
    [\()(())], [压1，弹1，压2，压3，弹3，弹2], [132],
    [\()()()], [压1，弹1，压2，弹2，压3，弹3], [123],
  )]
  , kind: table
