  align(center)[#table(
    columns: 4,
    align: (right,auto,auto,right,),
    table.header([r], [实际区间], [重新加的式子], [和],),
    table.hline(),
    [1], [\[3\]], [3], [3],
    [2], [\[3,−1\]], [3−1], [2],
    [3], [\[3,−1,4\]], [3−1+4], [6],
    [4], [\[3,−1,4,−5\]], [3−1+4−5], [1],
    [5], [\[3,−1,4,−5,2\]], [3−1+4−5+2], [3],
  )]
  , kind: table
