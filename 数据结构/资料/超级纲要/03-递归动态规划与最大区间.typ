    columns: 4,
    align: (auto,auto,auto,right,),
    table.header([格子], [比较两个前缀的末字符], [读哪些已知格], [写入值],),
    table.hline(),
    [D\[1\]\[1\]：A/B], [不同], [上0，左0], [0],
    [D\[1\]\[2\]：A/BA], [A相同], [左上D\[0\]\[1\]+1=0+1], [1],
    [D\[1\]\[3\]：A/BAC], [A与C不同], [上D\[0\]\[3\]=0，左D\[1\]\[2\]=1], [1],
    [D\[2\]\[1\]：AB/B], [B相同], [左上D\[1\]\[0\]+1=0+1], [1],
    [D\[2\]\[2\]：AB/BA], [B与A不同], [上1，左1], [1],
    [D\[2\]\[3\]：AB/BAC], [B与C不同], [上1，左1], [1],
    [D\[3\]\[1\]：ABC/B], [C与B不同], [上1，左0], [1],
    [D\[3\]\[2\]：ABC/BA], [C与A不同], [上1，左1], [1],
    [D\[3\]\[3\]：ABC/BAC], [C相同], [左上D\[2\]\[2\]+1=1+1], [2],
  )]
  , kind: table
  )

完整表如下，表头写的是"实际前缀"，能防止把下标与长度混淆：

#figure(
  align(center)[#table(
    columns: 5,
    align: (auto,right,right,right,right,),
    table.header([第一串前缀＼第二串前缀], [空], [B], [BA], [BAC],),
    table.hline(),
    [空], [0], [0], [0], [0],
